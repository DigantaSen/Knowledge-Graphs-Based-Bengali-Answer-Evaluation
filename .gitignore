# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Trained model weights (large binary files) ───────────────────────────────
# Root-anchored: a bare 'models/' also matched src/models/ and hid the source.
# Weights are distributed through the Hugging Face repo instead.
/models/*
*.pth
*.pt
*.pkl
*.npz
*.joblib
*.h5
*.onnx

# ─── Dataset files ────────────────────────────────────────────────────────────
# The datasets are small and needed to reproduce the results, so they are
# tracked (a bare 'data/' also matched src/data/).  Augmented copies are
# regenerated on the first run.
/data/*_augmented.csv

# ─── Zip archives ─────────────────────────────────────────────────────────────
*.zip

# ─── Generated results directories ───────────────────────────────────────────
results/

# ─── Jupyter notebook checkpoints ────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Matplotlib / plot cache ─────────────────────────────────────────────────
*.png
*.pdf
*.svg

# ─── HuggingFace / Torch hub cache ───────────────────────────────────────────
.cache/
hub/

# ─── Logs and temp files ─────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Build / distribution ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/
site/

# ─── Coverage / testing ──────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ─── Environment files (secrets) ─────────────────────────────────────────────
.env
.env.*
secrets.json

# ─── Exceptions (files to keep despite broad ignores above) ────────────
# Keep the project report PDF
!report.pdf
# Keep the empty models/ directory as a download target
!/models/.gitkeep
# Keep the report source, its figures and the compiled PDF
!/report/
!/report/**
